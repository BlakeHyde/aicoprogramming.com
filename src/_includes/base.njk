{% set pageTitle %}{% if essay %}{{ essay.title }} · {% elif title %}{{ title }} · {% endif %}Co-Programming{% endset %}
{% set pageDescription %}{% if essay %}{{ essay.excerpt }}{% else %}Essays about the sociotechnical discipline of co-programming with AI tools.{% endif %}{% endset %}
{% set previewImage %}https://aicoprogramming.com{{ '/assets/social-preview.png' | url }}{% endset %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#F6F9F9">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:type" content="{% if essay %}article{% else %}website{% endif %}">
  <meta property="og:image" content="{{ previewImage }}">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Space invader">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ previewImage }}">
  <meta name="twitter:image:alt" content="Space invader">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&amp;family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&amp;family=IBM+Plex+Serif:ital,wght@0,400;0,600;0,700;1,400&amp;display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/math/temml.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
  <link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="AI Co-Programming." href="{{ '/feed.xml' | url }}">
</head>
<body{% if page.url == '/' %} class="home"{% endif %}>
  <a class="skip-link" href="#main">Skip to content</a>

  <main id="main" class="shell" tabindex="-1">{{ content | safe }}</main>
  <footer class="site-footer">
    <p>Copyright © {{ copyright }} by Blake Hyde. <a href="{{ '/feed.xml' | url }}">RSS</a>.</p>
  </footer>
</body>
</html>
