<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#F6F9F9">
  <title>{% if essay %}{{ essay.title }} · {% elif title %}{{ title }} · {% endif %}Co-Programming</title>
  <meta name="description" content="{% if essay %}{{ essay.excerpt }}{% else %}Co-Programming essays.{% endif %}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&amp;family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&amp;display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
  <link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <main id="main" class="shell" tabindex="-1">{{ content | safe }}</main>
</body>
</html>
